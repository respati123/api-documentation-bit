FROM node:24-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY vite.cloud.config.ts tsconfig.cloud.json ./
COPY src/cloud ./src/cloud
RUN npm run cloud:build

FROM nginx:1.27-alpine
COPY docker/cloud-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-cloud /usr/share/nginx/html
EXPOSE 80
