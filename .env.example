# Docker Compose local development
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=55433
API_PORT=3001
CLOUD_WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000

# Local invitation email capture (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Optional SMTP credentials for a non-Mailpit provider
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=API Documentation <no-reply@example.test>
# Mailpit inbox is fixed at http://localhost:8026; SMTP stays inside Compose.

# Desktop development API endpoint
VITE_API_URL=http://localhost:3001
# Cloud web app the desktop app opens in the browser for sign-in
VITE_CLOUD_URL=http://localhost:5174
